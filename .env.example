# ── Google Cloud & Gemini Engine Settings ─────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here
ENVIRONMENT=development

# ── Arize Phoenix OpenTelemetry Tracing Configurations ──
ENABLE_PHOENIX_TRACING=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=documentscan

# ── Ports mapping ─────────────────────────────
FASTAPI_PORT=8000
VITE_PORT=5173

# ── Redis & Message Queue Settings ─────────────
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9092

# ── Discord Bot Integration Settings ──────────
DISCORD_PUBLIC_KEY=your_discord_bot_public_key_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# ── CRM MCP Tool Settings ─────────────────────
CRM_MCP_ENDPOINT=http://localhost:5001
